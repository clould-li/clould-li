
<!DOCTYPE html>
<html lang="zh-CN">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>树匠 · Full-Stack Developer & Designer</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Noto+Serif+SC:wght@400;600;700;900&family=Noto+Sans+SC:wght@300;400;500;700&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet">
<style>
*,*::before,*::after{box-sizing:border-box;margin:0;padding:0}
:root{
  --bg:#fafaf8;
  --surface:#ffffff;
  --ink:#1a1a1a;
  --muted:#6b6b63;
  --faint:#d4d4cc;
  --green:#166534;
  --green-light:#22c55e;
  --green-soft:#f0fdf4;
  --amber:#b45309;
  --radius:12px;
  --font-serif:'Noto Serif SC',serif;
  --font-sans:'Noto Sans SC',sans-serif;
  --font-mono:'JetBrains Mono',monospace;
}
html{scroll-behavior:smooth}
body{
  font-family:var(--font-sans);
  background:var(--bg);
  color:var(--ink);
  line-height:1.7;
  -webkit-font-smoothing:antialiased;
}

/* Hero */
.hero{
  min-height:100vh;display:flex;align-items:center;justify-content:center;
  padding:80px 24px;position:relative;overflow:hidden;
}
.hero::before{
  content:'';position:absolute;top:-40%;right:-20%;
  width:600px;height:600px;
  background:radial-gradient(circle, rgba(34,197,94,.06) 0%, transparent 70%);
  border-radius:50%;
}
.hero::after{
  content:'';position:absolute;bottom:-10%;left:-10%;
  width:400px;height:400px;
  background:radial-gradient(circle, rgba(22,101,52,.04) 0%, transparent 70%);
  border-radius:50%;
}
.hero-content{
  position:relative;z-index:1;max-width:680px;text-align:center;
  animation:fadeUp .8s cubic-bezier(.16,1,.3,1);
}
@keyframes fadeUp{from{opacity:0;transform:translateY(32px)}to{opacity:1;transform:translateY(0)}}
.hero-tag{
  display:inline-block;font-family:var(--font-mono);font-size:13px;
  color:var(--green);background:var(--green-soft);
  padding:6px 16px;border-radius:99px;margin-bottom:24px;
  letter-spacing:1px;
}
.hero h1{
  font-family:var(--font-serif);font-size:clamp(42px,7vw,72px);
  font-weight:900;line-height:1.1;letter-spacing:-1px;
  margin-bottom:16px;
}
.hero h1 .highlight{
  background:linear-gradient(135deg, var(--green), #15803d);
  -webkit-background-clip:text;-webkit-text-fill-color:transparent;
  background-clip:text;
}
.hero-sub{
  font-size:18px;color:var(--muted);max-width:480px;margin:0 auto 32px;
}
.hero-cta{
  display:flex;gap:12px;justify-content:center;flex-wrap:wrap;
}
.btn{
  display:inline-flex;align-items:center;gap:8px;
  padding:12px 28px;border-radius:99px;
  font-family:var(--font-sans);font-size:15px;font-weight:500;
  text-decoration:none;transition:all .25s ease;
}
.btn-primary{
  background:var(--green);color:#fff;
  box-shadow:0 4px 20px rgba(22,101,52,.2);
}
.btn-primary:hover{transform:translateY(-2px);box-shadow:0 8px 30px rgba(22,101,52,.3)}
.btn-outline{
  border:1.5px solid var(--faint);color:var(--ink);
}
.btn-outline:hover{border-color:var(--green);color:var(--green)}

/* Section */
.section{
  max-width:960px;margin:0 auto;padding:100px 24px;
}
.section-label{
  font-family:var(--font-mono);font-size:12px;color:var(--green);
  text-transform:uppercase;letter-spacing:2px;margin-bottom:12px;
}
.section h2{
  font-family:var(--font-serif);font-size:clamp(28px,4vw,40px);
  font-weight:700;margin-bottom:48px;letter-spacing:-.5px;
}

/* Services */
.services-grid{
  display:grid;grid-template-columns:repeat(auto-fit,minmax(260px,1fr));
  gap:20px;
}
.service-card{
  background:var(--surface);
  border:1px solid var(--faint);
  border-radius:var(--radius);
  padding:32px 28px;
  transition:all .3s ease;
}
.service-card:hover{
  transform:translateY(-4px);
  box-shadow:0 12px 40px rgba(0,0,0,.06);
  border-color:var(--green-light);
}
.service-icon{font-size:32px;margin-bottom:16px}
.service-card h3{
  font-family:var(--font-serif);font-size:20px;font-weight:700;
  margin-bottom:8px;
}
.service-card p{font-size:14px;color:var(--muted);line-height:1.6}

/* Tech */
.tech-groups{
  display:grid;grid-template-columns:repeat(auto-fit,minmax(280px,1fr));
  gap:24px;
}
.tech-group{
  background:var(--surface);border:1px solid var(--faint);
  border-radius:var(--radius);padding:28px;
}
.tech-group h3{
  font-family:var(--font-serif);font-size:18px;font-weight:700;
  margin-bottom:16px;display:flex;align-items:center;gap:8px;
}
.tech-tags{display:flex;flex-wrap:wrap;gap:8px}
.tech-tag{
  font-family:var(--font-mono);font-size:12px;
  padding:4px 12px;border-radius:6px;
  background:var(--green-soft);color:var(--green);
  border:1px solid rgba(34,197,94,.15);
}

/* Projects */
.projects-list{display:flex;flex-direction:column;gap:20px}
.project-card{
  display:flex;gap:24px;
  background:var(--surface);border:1px solid var(--faint);
  border-radius:var(--radius);padding:28px;
  transition:all .3s ease;text-decoration:none;color:inherit;
  align-items:center;
}
.project-card:hover{
  transform:translateX(4px);
  border-color:var(--green-light);
  box-shadow:0 8px 30px rgba(0,0,0,.04);
}
.project-icon{
  width:56px;height:56px;border-radius:var(--radius);
  display:flex;align-items:center;justify-content:center;
  font-size:24px;flex-shrink:0;
}
.project-info{flex:1}
.project-info h3{
  font-family:var(--font-serif);font-size:18px;font-weight:700;margin-bottom:4px;
}
.project-info p{font-size:14px;color:var(--muted)}
.project-tags{display:flex;gap:6px;flex-wrap:wrap;margin-top:8px}
.project-tags span{
  font-size:11px;font-family:var(--font-mono);
  padding:2px 8px;border-radius:4px;
  background:#f4f4f0;color:var(--muted);
}
.project-arrow{color:var(--faint);font-size:20px;transition:transform .3s}
.project-card:hover .project-arrow{transform:translateX(4px);color:var(--green)}

/* CTA */
.cta-section{
  text-align:center;padding:120px 24px;
  background:linear-gradient(180deg, transparent, var(--green-soft) 40%, transparent);
}
.cta-section h2{
  font-family:var(--font-serif);font-size:clamp(28px,4vw,40px);
  font-weight:700;margin-bottom:16px;
}
.cta-section p{color:var(--muted);margin-bottom:32px;font-size:16px}
.cta-email{
  font-family:var(--font-mono);font-size:20px;color:var(--green);
  text-decoration:none;border-bottom:2px dashed var(--green-light);
  transition:all .2s;
}
.cta-email:hover{border-bottom-style:solid}

/* Footer */
.footer{
  text-align:center;padding:40px 24px;
  font-size:13px;color:var(--muted);
  border-top:1px solid var(--faint);
}
.footer a{color:var(--green);text-decoration:none}

@media(max-width:640px){
  .project-card{flex-direction:column;align-items:flex-start;gap:12px}
  .hero h1{font-size:36px}
}
</style>
</head>
